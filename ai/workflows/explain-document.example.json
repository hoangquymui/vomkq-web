{
  "format": "vomkq-ai-workflow-design-v1",
  "id": "explain-document-v1",
  "implementationState": "planned",
  "purpose": "Explain an approved project document with traceable evidence.",
  "input": {
    "documentId": "required",
    "documentVersion": "required",
    "question": "required"
  },
  "stages": [
    "validate-document-scope",
    "retrieve-evidence",
    "check-evidence-sufficiency",
    "generate-explanation",
    "validate-source-references",
    "publish-answer"
  ],
  "policy": {
    "strictSources": true,
    "missingEvidence": "return-insufficient-evidence",
    "allowedTools": [
      "rag.search"
    ],
    "writeApplicationState": false
  },
  "output": {
    "answer": "text",
    "citations": "document-id/version/page-or-section",
    "runId": "required",
    "workflowVersion": "required"
  }
}

