{
  "name": "vomkq-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "download-tiles": "node download-tactical-map.js",
    "download-tamdao": "node download-tactical-map.js --region=tamdao --minZoom=9 --maxZoom=13",
    "download-binhdinh": "node download-tactical-map.js --region=binhdinh --minZoom=9 --maxZoom=13",
    "download-terrain": "node download-tactical-terrain.js",
    "download-terrain-tamdao": "node download-tactical-terrain.js --region=tamdao --minZoom=8 --maxZoom=13",
    "download-terrain-binhdinh": "node download-tactical-terrain.js --region=binhdinh --minZoom=8 --maxZoom=13",
    "download-topo-mientrung": "node download-tactical-topo.js --region=mientrung --minZoom=8 --maxZoom=13",
    "download-topo-mientrung-fast": "node download-tactical-topo.js --region=mientrung --minZoom=8 --maxZoom=12",
    "download-topo-tamdao": "node download-tactical-topo.js --region=tamdao --minZoom=8 --maxZoom=13",
    "download-vector-list": "node download-tactical-vector.js --list",
    "download-vector-mientrung": "node download-tactical-vector.js --region=mientrung --chunkDeg=0.4",
    "download-vector-hatinh": "node download-tactical-vector.js --region=hatinh",
    "download-vector-hue": "node download-tactical-vector.js --region=hue",
    "download-vector-danang": "node download-tactical-vector.js --region=danang",
    "download-vector-quangngai": "node download-tactical-vector.js --region=quangngai",
    "download-vector-binhdinh": "node download-tactical-vector.js --region=binhdinh",
    "download-vector-gialai": "node download-tactical-vector.js --region=gialai",
    "download-vector-daklak": "node download-tactical-vector.js --region=daklak",
    "download-vector-lamdong": "node download-tactical-vector.js --region=lamdong",
    "download-vector-tamdao": "node download-tactical-vector.js --region=tamdao"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@turf/along": "7.4.0",
    "@turf/area": "7.4.0",
    "@turf/bbox": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/boolean-valid": "7.4.0",
    "@turf/circle": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/kinks": "7.4.0",
    "@turf/length": "7.4.0",
    "@turf/line-split": "7.4.0",
    "@turf/polygon-to-line": "7.4.0",
    "@turf/union": "7.4.0",
    "@types/three": "^0.186.0",
    "cesium": "^1.145.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "vite-plugin-cesium": "^1.2.23",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
